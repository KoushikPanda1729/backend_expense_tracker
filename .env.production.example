NODE_ENV=production
PORT=4000
# Hosted Postgres (Supabase, RDS, ...). Use a database of its own, not one another project uses.
# Supabase pooler: add ?sslmode=no-verify. Special characters in the password must be URL-encoded (# is %23).
DATABASE_URL=
# Only if DATABASE_URL is empty and you run the Postgres container (docker compose --profile local-db):
POSTGRES_PASSWORD=

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Generate: openssl rand -hex 32.  BACK THIS UP. Losing it makes saved PDF passwords and stored statements unreadable.
ENCRYPTION_KEY=

# Uploaded statements and photos go to S3. On EC2 give the instance an IAM role (see README), so no keys are stored here.
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
S3_PREFIX=kharcha/

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_MB=15
LOG_LEVEL=info

# 1 when a reverse proxy (Caddy, nginx, a load balancer) sits in front, so client IPs and rate limits are right
TRUST_PROXY=1
# Browsers only. The mobile app does not need CORS.
CORS_ORIGINS=
QPDF_PATH=qpdf

# The public host name. No domain? Use your server IP with dashes + .sslip.io, e.g. 54-198-215-66.sslip.io
DOMAIN=
